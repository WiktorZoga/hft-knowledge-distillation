# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
# Kaggle credentials are only needed if you use scripts/download_data.py and do
# not already have ~/.kaggle/kaggle.json configured.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Weights & Biases API key (optional; only needed for online logging).
WANDB_API_KEY=your_wandb_key
